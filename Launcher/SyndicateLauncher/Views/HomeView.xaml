<UserControl x:Class="SyndicateLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Home: a top bar (player, season picker, Select Build, settings), the season hero (chapter, season, tagline,
         Play and Build Options over the season art) and three tiles (Total Playtime, Recent Match, Career).
         Panels are translucent (Tint_8C...), so the lobby theme behind the launcher shows through.
         DataContext is MainViewModel; the dashboard data is MainViewModel.Home (HomeViewModel). -->
    <UserControl.Resources>
        <Style x:Key="Glass" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Tint_8C141414}" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22,18" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#C4C4CC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="40" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#B4B4BE" />
        </Style>

        <!-- Top-bar picker (player, season): flat, with a soft highlight on hover. -->
        <Style x:Key="BarPicker" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusRing}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero buttons: Play (solid white) and Build Options (outlined). Tag "Outline" picks the second look. -->
        <Style x:Key="HeroButton" TargetType="Button">
            <Setter Property="Height" Value="50" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="Padding" Value="26,0" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111114" />
            <Setter Property="Background" Value="#F2F2F4" />
            <Setter Property="BorderBrush" Value="#F2F2F4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" />
                            <Border x:Name="Lift" CornerRadius="6" Background="#FFFFFF" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Lift" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Lift" Property="Opacity" Value="0.2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Outline">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Background" Value="#33000000" />
                    <Setter Property="BorderBrush" Value="#73FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Select Build: the accent-filled button in the top bar. -->
        <Style x:Key="AccentBarButton" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="34,0" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Accent_8C}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" />
                            <Border x:Name="Lift" CornerRadius="8" Background="#FFFFFF" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Lift" Property="Opacity" Value="0.1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Lift" Property="Opacity" Value="0.18" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SquareBarButton" TargetType="Button">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Tint_8C141414}"
                                BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <!-- ======================= TOP BAR ======================= -->
        <Grid x:Name="Hub" x:FieldModifier="public">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Player -->
            <Button Style="{StaticResource BarPicker}" Command="{Binding OpenPlayerSelectCommand}" Margin="-8,0,0,0"
                    ToolTip="Choose player and profile picture" AutomationProperties.Name="Player profile">
                <StackPanel Orientation="Horizontal">
                    <Border Width="60" Height="60" CornerRadius="30" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                        <Grid>
                            <Ellipse Fill="{DynamicResource Tint_FF1B1B1B}" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding PlayerAvatarImage}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding PlayerInitial}" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="{Binding PlayerInitialVisibility}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Width="150">
                        <TextBlock Text="{Binding PlayerName}" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PlayerStatus}" Style="{StaticResource Sub}" FontSize="14.5" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#C4C4CC"
                               VerticalAlignment="Center" Margin="10,0,6,0" />
                </StackPanel>
            </Button>

            <!-- Season -->
            <Border Grid.Column="1" Width="1" Height="44" Background="#1FFFFFFF" HorizontalAlignment="Left" Margin="18,0,0,0" />
            <Button Grid.Column="1" Style="{StaticResource BarPicker}" Margin="38,0,0,0"
                    Command="{Binding OpenPlayCommand}" ToolTip="Pick a season on the timeline"
                    AutomationProperties.Name="Choose chapter and season">
                <StackPanel Orientation="Horizontal">
                    <Border Width="76" Height="66" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource Tint_FF1B1B1B}">
                        <Grid>
                            <Border CornerRadius="7">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ActiveSeason.CardArt}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="7">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.45" />
                                        <GradientStop Color="#C0000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold"
                                       Foreground="White" Margin="7,0,0,3" VerticalAlignment="Bottom">
                                <Run Text="S" /><Run Text="{Binding ActiveSeason.Code, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <Border.CacheMode><BitmapCache EnableClearType="False" /></Border.CacheMode>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="18,0,0,0" Width="196">
                        <TextBlock Text="{Binding ActiveSeasonHeading}" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ActiveSeasonVersionText}" Style="{StaticResource Sub}" FontSize="14.5" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#C4C4CC"
                               VerticalAlignment="Center" Margin="10,0,6,0" />
                </StackPanel>
            </Button>
            <Border Grid.Column="2" Width="1" Height="44" Background="#1FFFFFFF" HorizontalAlignment="Left" Margin="18,0,0,0" />

            <!-- Select Build / Settings -->
            <Button Grid.Column="3" Style="{StaticResource AccentBarButton}" Command="{Binding BrowseCommand}"
                    ToolTip="Choose your Fortnite build folder" AutomationProperties.Name="Select build folder">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="SELECT BUILD" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource SquareBarButton}" Margin="22,0,0,0"
                    Command="{Binding ToggleSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Game settings">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="19" />
            </Button>
        </Grid>

        <!-- ======================= SEASON HERO ======================= -->
        <Border Grid.Row="2" CornerRadius="14" BorderBrush="#1FFFFFFF" BorderThickness="1" Background="{DynamicResource Tint_FF151515}">
            <Grid>
                <Border CornerRadius="13">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding ActiveSeasonArt}" Stretch="UniformToFill" AlignmentX="Right" />
                    </Border.Background>
                </Border>
                <Border CornerRadius="13">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource TintColor_FF0C0C0C}" Offset="0" />
                            <GradientStop Color="#E00C0C10" Offset="0.3" />
                            <GradientStop Color="#400C0C10" Offset="0.62" />
                            <GradientStop Color="#000C0C10" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="46,0,0,0">
                    <TextBlock Text="{Binding ActiveSeason.ChapterText}" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                               FontWeight="SemiBold" Foreground="#B4B4BE" />
                    <TextBlock Text="{Binding ActiveSeason.Label}" FontFamily="{StaticResource DisplayFont}" FontSize="60"
                               FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="4,-2,0,0">
                        <TextBlock.RenderTransform><SkewTransform AngleX="-9" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{Binding ActiveSeason.TaglineCaps}" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                               FontWeight="SemiBold" Foreground="#A8A8B4" Margin="0,-4,0,0" />
                    <Border Width="46" Height="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Left" Margin="0,22,0,26" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource HeroButton}" Command="{Binding PlayCommand}"
                                ToolTip="{Binding PlayHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Play">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock Text="PLAY" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HeroButton}" Tag="Outline" Margin="18,0,0,0"
                                Command="{Binding OpenActiveChapterCommand}" ToolTip="This chapter's seasons and their builds"
                                AutomationProperties.Name="Build options">
                            <TextBlock Text="BUILD OPTIONS" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- V-Bucks, and (developer build only) the in-game menu warning. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0">
                    <Border CornerRadius="10" Padding="10,5" Background="#B3201010" BorderBrush="#66E0533B" BorderThickness="1"
                            Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding EnableMenu, Converter={StaticResource BoolToVis}}"
                            ToolTip="Matches played with the in-game menu on earn no V-Bucks. Turn the menu off in Settings.">
                        <TextBlock Text="In-game menu is on: matches earn no V-Bucks" FontSize="11" FontWeight="SemiBold" Foreground="#FFC9BE" />
                    </Border>
                    <Border CornerRadius="18" Padding="6,4,14,4" Background="#B30A0A0E" BorderBrush="#26FFFFFF" BorderThickness="1"
                            ToolTip="Your V-Bucks. Eliminations and wins in matches earn more.">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/SyndicateLauncher;component/Assets/vbucks.png" Width="24" Height="24"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Home.VBucksText}" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                       FontWeight="SemiBold" Foreground="#FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= TILES ======================= -->
        <Grid x:Name="StatsRow" x:FieldModifier="public" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.94*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.07*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.07*" />
            </Grid.ColumnDefinitions>

            <!-- Total Playtime -->
            <Border Style="{StaticResource Glass}" ToolTip="{Binding Home.TotalGames, StringFormat={}{0} sessions in Tilt}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" Style="{StaticResource TileIcon}" />
                        <TextBlock Text="TOTAL PLAYTIME" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Home.TotalPlaytime}" Style="{StaticResource Big}" FontSize="46"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- Recent Match -->
            <Border Grid.Column="2" Style="{StaticResource Glass}">
                <Grid x:Name="RecentRow" x:FieldModifier="public">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource TileIcon}" />
                        <TextBlock Text="RECENT MATCH" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                    <Button Grid.Row="1" Grid.ColumnSpan="2" Command="{Binding OpenStatsCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            ToolTip="See all your matches" AutomationProperties.Name="Recent match">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Button.Template>
                        <Grid Background="Transparent" DataContext="{Binding Home.LatestMatch}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBlock x:Name="Place" Text="{Binding PlaceText}" VerticalAlignment="Center" MinWidth="80">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Big}">
                                        <Setter Property="FontSize" Value="46" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Won}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Grid.Column="1" Width="1" Height="54" Background="#22FFFFFF" Margin="20,0,24,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Sub}" Foreground="{DynamicResource TextBrush}" FontSize="15"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding SeasonText, Mode=OneWay}" /><Run Text="  &#x2022;  " /><Run Text="{Binding ModeText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding KillsText}" Style="{StaticResource Sub}" FontSize="15" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                Visibility="{Binding Home.ShowRecentPlaceholder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Home.RecentPlaceholder}" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                        <Button Style="{StaticResource LinkButton}" Command="{Binding Home.RefreshCommand}" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBlock Text="TRY AGAIN" FontSize="10" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Career -->
            <Border Grid.Column="4" Style="{StaticResource Glass}" ToolTip="{Binding Home.WinRate, StringFormat=Win rate {0}. Click for all statistics.}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" Style="{StaticResource TileIcon}" />
                        <TextBlock Text="CAREER" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                    <Button Grid.Row="1" Command="{Binding OpenStatsCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            AutomationProperties.Name="Open statistics">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Button.Template>
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Home.Wins}" Style="{StaticResource Big}" FontSize="36" HorizontalAlignment="Center" />
                                <TextBlock Text="Wins" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Height="54" Background="#22FFFFFF" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Home.Kills}" Style="{StaticResource Big}" FontSize="36" HorizontalAlignment="Center" />
                                <TextBlock Text="Elims" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="3" Height="54" Background="#22FFFFFF" />
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Home.Matches}" Style="{StaticResource Big}" FontSize="36" HorizontalAlignment="Center" />
                                <TextBlock Text="Matches" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
