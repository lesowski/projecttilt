<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SyndicateLauncher</AssemblyName>
    <RootNamespace>SyndicateLauncher</RootNamespace>
    <ApplicationIcon>Assets\tilt.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <!-- AssemblyName/RootNamespace stay SyndicateLauncher (pack URIs, embedded runtime, obfuscar.xml and the dev
         scripts depend on them). Launcher/build-public.cmd and build-dev.cmd name the shipped exe TiltLauncher. -->
    <Product>Tilt Launcher</Product>
    <Company>Project Tilt</Company>
    <Authors>Project Tilt; original launcher by Unkn0wn (d4shyb0i), Joey, Sact, Trent, Alfie</Authors>
    <!-- The original authors' MIT copyright notice must stay (LICENSE). -->
    <Copyright>Copyright (c) 2026 Project Tilt. Based on MIT-licensed code, Copyright (c) 2026 Unkn0wn, Joey, Sact, Trent, and Alfie.</Copyright>
    <Trademark>Tilt</Trademark>
    <AssemblyTitle>Tilt Launcher</AssemblyTitle>
    <Description>Tilt Launcher.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Two editions (Launcher/build-public.cmd, Launcher/build-dev.cmd):
       Developer build (-p:SyndicateDevBuild=true, also what UPDATE FROM GIT.cmd makes): defines DEV_BUILD. DEVELOPER
       BUILD badge, the in-game menu toggle, Syndicate Studio, the backend's developer routes, Save the World tools.
       Public build (default): none of that is compiled in. -->
  <PropertyGroup Condition="'$(SyndicateDevBuild)'=='true'">
    <DefineConstants>$(DefineConstants);DEV_BUILD</DefineConstants>
  </PropertyGroup>
  <!-- Public build: the Studio window and its tools (game docking, SyndicateStudio.dll pipe, map editing, fly) are not
       compiled. Studio/StudioSession.cs stays: normal Play reads the playlist through it, and its Current() is null. -->
  <ItemGroup Condition="'$(SyndicateDevBuild)'!='true'">
    <Compile Remove="Studio\StudioWindow.cs;Studio\StudioEditing.cs;Studio\StudioGizmoOverlay.cs;Studio\StudioMapSession.cs;Studio\StudioPipeClient.cs;Studio\NativeEmbed.cs;Studio\ProcessAudio.cs" />
  </ItemGroup>
  <ItemGroup>
